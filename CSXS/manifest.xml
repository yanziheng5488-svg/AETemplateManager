<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.example.ae.fn.template-manager" ExtensionBundleVersion="0.1.0">
  <ExtensionList>
    <Extension Id="com.example.ae.fn.template-manager.panel" Version="0.1.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[24.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.example.ae.fn.template-manager.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./src/panel/index.html</MainPath>
          <ScriptPath>./src/host/main.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--enable-media-stream</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>AE FN 模板管理</Menu>
          <Geometry>
            <Size>
              <Width>420</Width>
              <Height>720</Height>
            </Size>
          </Geometry>
          <MaxSize>
            <Width>1200</Width>
            <Height>1600</Height>
          </MaxSize>
          <MinSize>
            <Width>360</Width>
            <Height>480</Height>
          </MinSize>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
